{
  "name": "qingzhuan",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "轻转 MDWord：本地离线的 Markdown 与 Word 双向转换工具，无需 AI，文件不上传，支持表格与图片。",
  "repository": {
    "type": "git",
    "url": "https://github.com/MyLittleShrimp/QingZhuan-by-LittleShrimp.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node scripts/build.mjs --test && node --test tests/*.test.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "docx": "9.7.1",
    "jszip": "3.10.1",
    "mammoth": "1.12.3",
    "markdown-it": "14.3.2",
    "turndown": "7.2.4"
  },
  "devDependencies": {
    "@types/markdown-it": "14.1.2",
    "@types/turndown": "5.0.6",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
